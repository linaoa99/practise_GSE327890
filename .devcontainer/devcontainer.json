{
  "name": "nf-core/rnaseq with Pixi",
  "image": "mcr.microsoft.com/devcontainers/base:ubuntu",

  // Mount the project at the SAME path it has in WSL, so the host Docker
  // daemon (used by Nextflow) can see the same files. Open the project from WSL.
  "workspaceMount": "source=${localWorkspaceFolder},target=${localWorkspaceFolder},type=bind",
  "workspaceFolder": "${localWorkspaceFolder}",

  "features": {
    "ghcr.io/devcontainers/features/docker-outside-of-docker:1": {}
  },

  "remoteUser": "vscode",

  "remoteEnv": {
    "PATH": "${containerEnv:PATH}:/home/vscode/.pixi/bin"
  },

  // Runs once, when the container is created
  "postCreateCommand": "command -v pixi >/dev/null || curl -fsSL https://pixi.sh/install.sh | bash; if [ -f pixi.toml ]; then /home/vscode/.pixi/bin/pixi install; fi",

  "customizations": {
    "vscode": {
      "extensions": [
        "nextflow.nextflow",
        "ms-python.python",
        "ms-azuretools.vscode-docker"
      ],
      "settings": {
        "python.defaultInterpreterPath": "${workspaceFolder}/.pixi/envs/default/bin/python",
        "python.terminal.activateEnvironment": false
      }
    }
  }
}